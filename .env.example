# Copy to .env and fill in. Only the provider key is required.

# --- Primary provider: Google AI Studio (Gemini) --------------------------
# One key serves both chat and embeddings. Free at
# https://aistudio.google.com/apikey -- a permanently free tier with rate
# limits, not trial credit that expires.
GEMINI_API_KEY=
LLM_PROVIDER=gemini

# Verify these exist on your key before relying on them; a model missing from
# the key 404s at request time, not at start-up:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#     | grep -o '"name": "models/[^"]*"'
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2

# --- Alternative provider: any OpenAI-compatible endpoint -----------------
# Groq, OpenRouter, vLLM. Set LLM_PROVIDER=openai_compat to switch.
# Embeddings do not run through this provider -- without a Gemini key as well,
# retrieval degrades to lexical-only and /healthz reports embeddings:false.
# Groq's free tier allows 8,000 tokens/minute against ~4-5k per agent turn,
# roughly one question every 40 seconds.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=openai/gpt-oss-120b

# --- Guardrail budgets (optional overrides) -------------------------------
# MAX_TOOL_CALLS_PER_TURN=8
# MAX_LOOP_ITERATIONS=6
# TURN_TIMEOUT_SECONDS=90
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# CONFIRMATION_TTL_SECONDS=300

# --- Retrieval (optional overrides) ---------------------------------------
# RAG_USE_EMBEDDINGS=true
# RAG_TOP_K=4
# RAG_COVERAGE_FLOOR=0.45
# Tuned to gemini-embedding-2 at 768 dims on this corpus: in-scope questions
# bottom out at 0.698, out-of-scope top out at 0.658. Re-measure if you change
# the embedding model or the corpus.
# RAG_COSINE_FLOOR=0.68
