# Copy this file to `.env` and add ONE free API key (see SETUP.md).
# Never commit a real key — `.env` is git-ignored on purpose.

# --- Provider: Groq (recommended — free, fast, no credit card) -------------
# Get a key in ~2 minutes at https://console.groq.com/keys
# Paste it after the = sign below. This is the only thing you must fill in.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=openai_compat

# Policy search runs lexical-only (BM25) by default, so no second key is needed.
# It works well for keyword questions ("laptop refresh cycle", "lost laptop").
# To turn on the semantic half too, see the Gemini block at the bottom.
RAG_USE_EMBEDDINGS=false

# --- Alternative providers (leave commented unless you want to switch) ------
# NVIDIA NIM — free, no daily cap, but SLOW (30-240s/answer). Not for a demo.
#   Get a key at https://build.nvidia.com, then set LLM_PROVIDER=nvidia_nim
# NVIDIA_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# --- Optional: turn on hybrid (semantic) retrieval -------------------------
# Add a free Gemini key (https://aistudio.google.com/apikey) and set
# RAG_USE_EMBEDDINGS=true above. Note: Gemini's free chat quota is only ~20
# requests/day, so use it for embeddings only — keep chat on Groq.
# GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-2

# --- Guardrail budgets (optional overrides) --------------------------------
# MAX_TOOL_CALLS_PER_TURN=8
# MAX_LOOP_ITERATIONS=6
# TURN_TIMEOUT_SECONDS=90
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# CONFIRMATION_TTL_SECONDS=300

# --- Retrieval (optional overrides) ----------------------------------------
# RAG_TOP_K=4
# RAG_COVERAGE_FLOOR=0.45
# RAG_COSINE_FLOOR=0.68
