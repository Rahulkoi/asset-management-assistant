# Copy to .env and fill in. Only the provider key is required.

# --- Provider -------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2

# --- Fallback provider (optional) -----------------------------------------
# Any OpenAI-compatible endpoint — Groq, OpenRouter, vLLM. Switch to it by
# setting LLM_PROVIDER=openai_compat when the primary free tier runs out.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# --- Guardrail budgets (optional overrides) -------------------------------
# MAX_TOOL_CALLS_PER_TURN=8
# MAX_LOOP_ITERATIONS=6
# TURN_TIMEOUT_SECONDS=90
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# CONFIRMATION_TTL_SECONDS=300

# --- Retrieval (optional overrides) ---------------------------------------
# RAG_USE_EMBEDDINGS=true
# RAG_TOP_K=4
# RAG_COVERAGE_FLOOR=0.45
# RAG_COSINE_FLOOR=0.60
